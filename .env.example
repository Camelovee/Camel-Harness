# 默认 Provider
CAMEL_PROVIDER=anthropic
CAMEL_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# 切换到 OpenAI 时使用
# CAMEL_PROVIDER=openai
# CAMEL_MODEL=your-openai-model
# OPENAI_API_KEY=

# OpenAI-compatible 或 Anthropic-compatible 网关可选配置
# CAMEL_ANTHROPIC_BASE_URL=
# CAMEL_OPENAI_BASE_URL=

# Runtime 预算与本地目录
# CAMEL_MAX_CONTEXT_CHARS=120000
# CAMEL_MAX_TOTAL_TOKENS=200000
# CAMEL_MAX_DURATION_SECONDS=900
# CAMEL_SESSION_DIR=.camel/sessions
# CAMEL_MCP_CONFIG=.mcp.json
