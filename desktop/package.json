{
  "name": "camel-harness-desktop",
  "productName": "Camel Harness",
  "version": "1.1.0",
  "private": true,
  "description": "Camel Harness 本地编程助手",
  "author": "Camel Harness contributors",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/create-icon.cjs && tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "pack": "npm run build && install-electron && electron-builder --dir",
    "dist": "npm run build && install-electron && electron-builder",
    "test:smoke": "npm run build && node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
