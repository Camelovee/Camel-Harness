{
  "name": "camel-harness-desktop",
  "productName": "Camel Harness",
  "version": "1.1.0",
  "private": true,
  "description": "Camel Harness 本地编程助手",
  "author": "Camel Harness contributors",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/create-icon.cjs && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && vite build",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "pack": "npm run build && install-electron && electron-builder --dir",
    "dist": "npm run build && install-electron && electron-builder",
    "test:smoke": "npm run build && node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
